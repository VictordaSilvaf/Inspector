# Copy to .env.production and fill secrets before starting:
#   cp .env.production.example .env.production
#   # set APP_KEY, DOMAIN, DB_PASSWORD, APP_URL, mail…
#   make prod-up
#   # or: ./bin/prod up -d --build
#
# Sail keeps using .env + compose.yaml for local development.
# Production uses a separate Compose project (inspector-prod) so it does not collide with Sail.

APP_NAME=Inspector
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=inspector
DB_USERNAME=inspector
DB_PASSWORD=change-me-strong-password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TRUSTED_PROXIES=*

# Docker Compose / Caddy
# Production (TLS automático): DOMAIN=example.com
# Smoke test local (só HTTP): DOMAIN=http://localhost
DOMAIN=example.com
HTTP_PORT=80
HTTPS_PORT=443
APP_IMAGE=inspector-app
